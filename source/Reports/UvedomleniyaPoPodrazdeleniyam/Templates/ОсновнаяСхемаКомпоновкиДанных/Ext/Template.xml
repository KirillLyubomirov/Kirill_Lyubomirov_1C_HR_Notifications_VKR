		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ У.VKRDepartment КАК Подразделение, О.State КАК Состояние,
 КОЛИЧЕСТВО(У.Ссылка) КАК КоличествоУведомлений
ИЗ РегистрСведений.VKRQueue КАК О
 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.OtpravkaUvedomleniya КАК У ПО О.Notification = У.Ссылка
ГДЕ У.Дата &gt;= НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ) И У.Дата &lt; ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&amp;КонецПериода, ДЕНЬ), ДЕНЬ, 1)
СГРУППИРОВАТЬ ПО У.VKRDepartment, О.State
</query>
