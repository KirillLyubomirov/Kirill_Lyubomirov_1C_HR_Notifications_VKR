		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ О.Период КАК ДатаОтправки, У.Ссылка КАК Уведомление,
 К.Ссылка КАК КадровоеСобытие, У.Sotrudnik КАК Сотрудник,
 О.Email КАК АдресНаМоментОтправки, У.VKRDepartment КАК Подразделение,
 О.TemaPisma КАК Тема, О.Kolichestvo КАК Количество
ИЗ РегистрНакопления.OtpravlennyeUvedomleniya КАК О
 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.OtpravkaUvedomleniya КАК У ПО О.Регистратор = У.Ссылка
 ЛЕВОЕ СОЕДИНЕНИЕ Документ.KadrovoyeIzmenenie КАК К ПО У.KadrovoyeIzmenenie = К.Ссылка
ГДЕ О.Активность И О.Период &gt;= НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ) И О.Период &lt; ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&amp;КонецПериода, ДЕНЬ), ДЕНЬ, 1)
УПОРЯДОЧИТЬ ПО О.Период УБЫВ
</query>
