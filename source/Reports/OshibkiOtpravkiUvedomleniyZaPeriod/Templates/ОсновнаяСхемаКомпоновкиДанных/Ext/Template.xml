		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ О.Период КАК ДатаОшибки, Д.Ссылка КАК ДокументОшибки,
 У.Ссылка КАК Уведомление, У.Email КАК Адрес, П.AttemptID КАК Попытка,
 П.Outcome КАК Результат, О.OpisanieOshibki КАК Причина
ИЗ РегистрНакопления.OshibkiOtpravkiUvedomleniy КАК О
 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.RegistratsiyaOshibkiOtpravki КАК Д ПО О.Регистратор = Д.Ссылка
 ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.OtpravkaUvedomleniya КАК У ПО Д.VKRNotification = У.Ссылка
 ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.VKRAttempts КАК П ПО Д.VKRAttemptID = П.AttemptID
ГДЕ О.Активность И О.Период &gt;= НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ) И О.Период &lt; ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&amp;КонецПериода, ДЕНЬ), ДЕНЬ, 1)
УПОРЯДОЧИТЬ ПО О.Период УБЫВ
</query>
