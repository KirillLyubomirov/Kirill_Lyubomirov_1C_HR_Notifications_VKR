Процедура ПередЗаписью(Отказ)
    Если ОбменДанными.Загрузка Тогда
        Отказ = Истина;
        Сообщить("Прямая загрузка этого служебного объекта через обмен не поддерживается.");
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(БизнесПроцесс) Тогда
        Отказ = Истина;
        Сообщить("Задача создаётся маршрутом контроля кадрового изменения.");
        Возврат;
    КонецЕсли;
    KadrovoyeIzmenenie = БизнесПроцесс.KadrovoyeIzmenenie;
КонецПроцедуры

Процедура ПередВыполнением(Отказ)
    Попытка
        Если НЕ ЗначениеЗаполнено(KadrovoyeIzmenenie) Тогда
            ВызватьИсключение "В задаче нет кадрового события.";
        КонецЕсли;
        Событие = KadrovoyeIzmenenie.ПолучитьОбъект();
        Если Событие.ПометкаУдаления Тогда
            ВызватьИсключение "Кадровое событие помечено на удаление.";
        КонецЕсли;
        Точки = БизнесПроцессы.ObrabotkaKadrovogoIzmeneniya.ТочкиМаршрута;
        ЭтапКадровика = ТочкаМаршрута = Точки.ProverkaKadrovikom
            Или ТочкаМаршрута = Точки.FormirovanieUvedomleniya;
        Если НЕ РольДоступна("Administrator") Тогда
            Если (ЭтапКадровика И НЕ РольДоступна("Kadrovik"))
                Или (НЕ ЭтапКадровика И НЕ РольДоступна("OperatorUvedomleniy")) Тогда
                ВызватьИсключение "У текущей роли нет права завершать этот этап маршрута.";
            КонецЕсли;
        КонецЕсли;
        Если ТочкаМаршрута = Точки.ProverkaKadrovikom Тогда
            VKRHR.ПроверитьСобытие(Событие);
            Если Событие.TrebuyetsyaUvedomleniye Тогда
                VKRRules.ПодготовитьПисьма(Событие);
            КонецЕсли;
        ИначеЕсли ТочкаМаршрута = Точки.FormirovanieUvedomleniya Тогда
            Событие.Записать(РежимЗаписиДокумента.Проведение);
        Иначе
            Если НЕ Событие.Проведен Тогда
                ВызватьИсключение "Кадровое событие не проведено.";
            КонецЕсли;
            ПроверитьОчередь(ТочкаМаршрута = Точки.PovtornayaOtpravka);
        КонецЕсли;
    Исключение
        Отказ = Истина;
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОчередь(ТребоватьРазбораОшибок)
    Запрос = Новый Запрос("ВЫБРАТЬ О.State КАК Состояние
        |ИЗ РегистрСведений.VKRQueue КАК О ГДЕ О.Event = &Событие");
    Запрос.УстановитьПараметр("Событие", KadrovoyeIzmenenie);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        С = Выборка.Состояние;
        Если С = Перечисления.VKRQueueStates.Prepared
            Или С = Перечисления.VKRQueueStates.Retry
            Или С = Перечисления.VKRQueueStates.Sending Тогда
            ВызватьИсключение "Отправка ещё не закончена. Обработайте очередь в панели уведомлений.";
        КонецЕсли;
        Если ТребоватьРазбораОшибок И (С = Перечисления.VKRQueueStates.Unknown
            Или С = Перечисления.VKRQueueStates.Failed) Тогда
            ВызватьИсключение "Остались ошибки или неизвестный результат. Зафиксируйте решение оператора.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
