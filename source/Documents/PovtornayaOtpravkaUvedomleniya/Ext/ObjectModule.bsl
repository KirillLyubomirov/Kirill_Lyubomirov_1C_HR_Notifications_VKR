Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    Если ОбменДанными.Загрузка Тогда
        Отказ = Истина;
        Сообщить("Прямая загрузка этого служебного объекта через обмен не поддерживается.");
        Возврат;
    КонецЕсли;
    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Отказ = Истина;
        Сообщить("Решение о повторе сохраняется в истории и не отменяется перепроведением.");
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Попытка
        Если НЕ ЗначениеЗаполнено(IshodnoyeUvedomleniye) Тогда
            ВызватьИсключение "Выберите исходное уведомление.";
        КонецЕсли;
        VKROperator.Решить(IshodnoyeUvedomleniye, "Retry", Kommentariy,
            Строка(Ссылка.УникальныйИдентификатор()));
    Исключение
        Отказ = Истина;
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
