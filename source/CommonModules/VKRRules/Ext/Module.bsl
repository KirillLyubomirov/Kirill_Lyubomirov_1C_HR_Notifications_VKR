// Подбор адресатов и формирование письма для учебного стенда.
// Контракт метаданных: metadata_changes.json. Модуль серверный, неглобальный.

Функция НормализоватьEmail(Знач Адрес) Экспорт
    Адрес = СокрЛП(Строка(Адрес));
    Если ПустаяСтрока(Адрес) Или СтрДлина(Адрес) > 254 Тогда
        ВызватьИсключение "Email пустой или превышает 254 символа.";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Адрес) Цикл
        Код = КодСимвола(Адрес, Позиция);
        Если Код <= 32 Или Код >= 127 Тогда
            ВызватьИсключение "Для учебного почтового профиля требуется адрес ASCII без пробелов.";
        КонецЕсли;
    КонецЦикла;
    Части = СтрРазделить(Адрес, "@", Истина);
    Если Части.Количество() <> 2 Тогда
        ВызватьИсключение "Email должен содержать один символ @.";
    КонецЕсли;
    ЛокальнаяЧасть = Части[0];
    Домен = Части[1];
    Если ПустаяСтрока(ЛокальнаяЧасть) Или СтрДлина(ЛокальнаяЧасть) > 64
        Или ПустаяСтрока(Домен) Тогда
        ВызватьИсключение "Неверная длина частей email.";
    КонецЕсли;
    Если Лев(ЛокальнаяЧасть, 1) = "." Или Прав(ЛокальнаяЧасть, 1) = "."
        Или СтрНайти(ЛокальнаяЧасть, "..") > 0 Тогда
        ВызватьИсключение "Неверное расположение точки в email.";
    КонецЕсли;
    Разрешено = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.!#$%&'*+-/=?^_`{|}~";
    Для Позиция = 1 По СтрДлина(ЛокальнаяЧасть) Цикл
        Если СтрНайти(Разрешено, Сред(ЛокальнаяЧасть, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "Неподдерживаемый символ в email.";
        КонецЕсли;
    КонецЦикла;
    МеткиДомена = СтрРазделить(Домен, ".", Истина);
    Если МеткиДомена.Количество() < 2 Тогда
        ВызватьИсключение "Укажите доменное имя email.";
    КонецЕсли;
    Для Каждого Метка Из МеткиДомена Цикл
        Если ПустаяСтрока(Метка) Или СтрДлина(Метка) > 63
            Или Лев(Метка, 1) = "-" Или Прав(Метка, 1) = "-" Тогда
            ВызватьИсключение "Неверная часть доменного имени.";
        КонецЕсли;
        Для Позиция = 1 По СтрДлина(Метка) Цикл
            Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789-", НРег(Сред(Метка, Позиция, 1))) = 0 Тогда
                ВызватьИсключение "Неверный символ доменного имени.";
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    // Регистр локальной части сохраняется. Домен регистронезависим.
    Возврат ЛокальнаяЧасть + "@" + НРег(Домен);
КонецФункции

Функция НайтиПравило(ВидИзменения) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 2 П.Ссылка КАК Правило
        |ИЗ Справочник.PravilaRassylki КАК П
        |ГДЕ П.Aktivno И НЕ П.ПометкаУдаления
        |И П.VidIzmeneniya = &Вид";
    Запрос.УстановитьПараметр("Вид", ВидИзменения);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 0 Тогда
        ВызватьИсключение "Для вида изменения нет активного правила рассылки.";
    КонецЕсли;
    Если Таблица.Количество() > 1 Тогда
        ВызватьИсключение "Для вида изменения разрешено только одно активное правило.";
    КонецЕсли;
    Правило = Таблица[0].Правило.ПолучитьОбъект();
    Если НЕ ЗначениеЗаполнено(Правило.GruppaPoluchateley)
        Или НЕ ЗначениеЗаполнено(Правило.ShablonPisma) Тогда
        ВызватьИсключение "В правиле не указаны группа или шаблон.";
    КонецЕсли;
    Возврат Правило;
КонецФункции

Функция ПолучитьАдресатов(Документ, Правило) Экспорт
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Получатель");
    Результат.Колонки.Добавить("Email");
    Ссылки = Новый Соответствие;
    Адреса = Новый Соответствие;
    Если Документ.VKRManualRecipients Тогда
        Строки = Документ.Poluchateli;
    Иначе
        Группа = Правило.GruppaPoluchateley.ПолучитьОбъект();
        Если Группа.ПометкаУдаления Тогда
            ВызватьИсключение "Группа получателей помечена на удаление.";
        КонецЕсли;
        Строки = Группа.SostavGruppy;
    КонецЕсли;
    Для Каждого СтрокаСостава Из Строки Цикл
        Получатель = СтрокаСостава.Poluchatel;
        Если НЕ ЗначениеЗаполнено(Получатель) Тогда
            Продолжить;
        КонецЕсли;
        Карточка = Получатель.ПолучитьОбъект();
        Если Карточка.ПометкаУдаления Или НЕ Карточка.Aktiven Тогда
            Продолжить;
        КонецЕсли;
        Если Документ.VKRManualRecipients Тогда
            Адрес = НормализоватьEmail(СтрокаСостава.Email);
        Иначе
            Адрес = НормализоватьEmail(Карточка.Email);
        КонецЕсли;
        Если Ссылки.Получить(Получатель) <> Неопределено
            Или Адреса.Получить(Адрес) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Ссылки.Вставить(Получатель, Истина);
        Адреса.Вставить(Адрес, Истина);
        СтрокаРезультата = Результат.Добавить();
        СтрокаРезультата.Получатель = Получатель;
        СтрокаРезультата.Email = Адрес;
    КонецЦикла;
    Если Результат.Количество() = 0 Тогда
        ВызватьИсключение "В рассылке нет активных получателей с допустимыми адресами.";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ПараметрыПисьма(Документ) Экспорт
    П = Новый Структура;
    П.Вставить("EmployeeName", Строка(Документ.Sotrudnik));
    П.Вставить("Reason", Строка(Документ.VKRReason));
    П.Вставить("SourceKind", Строка(Документ.VKRSourceKind));
    П.Вставить("EventType", Строка(Документ.VidIzmeneniya));
    П.Вставить("EffectiveDate", Формат(Документ.DataIzmeneniya, "ДФ=dd.MM.yyyy"));
    П.Вставить("DepartmentBefore", Строка(Документ.PodrazdelenieDo));
    П.Вставить("DepartmentAfter", Строка(Документ.PodrazdeleniePosle));
    П.Вставить("PositionBefore", Строка(Документ.DolzhnostDo));
    П.Вставить("PositionAfter", Строка(Документ.DolzhnostPosle));
    // Оклад не входит в общую рассылку. Для него нужен отдельный набор прав и шаблонов.
    Возврат П;
КонецФункции

Функция ПрименитьШаблон(Знач Текст, Параметры) Экспорт
    Результат = "";
    Пока НЕ ПустаяСтрока(Текст) Цикл
        Начало = СтрНайти(Текст, "{{");
        Если Начало = 0 Тогда
            Если СтрНайти(Текст, "}}") > 0 Тогда
                ВызватьИсключение "В шаблоне лишняя закрывающая скобка.";
            КонецЕсли;
            Результат = Результат + Текст;
            Прервать;
        КонецЕсли;
        Префикс = Лев(Текст, Начало - 1);
        Если СтрНайти(Префикс, "}}") > 0 Тогда
            ВызватьИсключение "В шаблоне лишняя закрывающая скобка.";
        КонецЕсли;
        Результат = Результат + Префикс;
        Остаток = Сред(Текст, Начало + 2);
        Конец = СтрНайти(Остаток, "}}");
        Если Конец = 0 Тогда
            ВызватьИсключение "В шаблоне не закрыт параметр.";
        КонецЕсли;
        Имя = СокрЛП(Лев(Остаток, Конец - 1));
        Значение = Неопределено;
        Если НЕ Параметры.Свойство(Имя, Значение) Тогда
            ВызватьИсключение "Неизвестный параметр шаблона: " + Имя;
        КонецЕсли;
        // Подстановка однократная: скобки внутри значения повторно не интерпретируются.
        Результат = Результат + Строка(Значение);
        Текст = Сред(Остаток, Конец + 2);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПодготовитьПисьма(Документ) Экспорт
    Правило = НайтиПравило(Документ.VidIzmeneniya);
    ПочтовыйПрофиль = Константы.VKRSMTPProfile.Получить();
    Если ЗначениеЗаполнено(Правило.VKRChannel) Тогда
        Канал = Правило.VKRChannel.ПолучитьОбъект();
        Если Канал.ПометкаУдаления Или НЕ Канал.Aktiven Тогда
            ВызватьИсключение "Почтовый канал выключен или помечен на удаление.";
        КонецЕсли;
        Если ЗначениеЗаполнено(Канал.VKRSMTPProfile) Тогда
            ПочтовыйПрофиль = Канал.VKRSMTPProfile;
        КонецЕсли;
    КонецЕсли;
    Шаблон = Правило.ShablonPisma.ПолучитьОбъект();
    Если Шаблон.ПометкаУдаления Или НЕ Шаблон.Aktiven Или Шаблон.ЭтоГруппа Тогда
        ВызватьИсключение "Выбран недействующий шаблон письма.";
    КонецЕсли;
    Параметры = ПараметрыПисьма(Документ);
    Тема = ПрименитьШаблон(Шаблон.TemaPisma, Параметры);
    Текст = ПрименитьШаблон(Шаблон.TekstPisma, Параметры);
    Если ПустаяСтрока(Тема) Или ПустаяСтрока(Текст) Тогда
        ВызватьИсключение "Тема и текст письма обязательны.";
    КонецЕсли;
    Если СтрНайти(Тема, Символы.ПС) > 0 Или СтрНайти(Тема, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Тема не должна содержать переводов строк.";
    КонецЕсли;
    Возврат Новый Структура("Адресаты,Тема,Текст,Правило,Шаблон,Профиль,Канал,Назначение",
        ПолучитьАдресатов(Документ, Правило), Тема, Текст, Правило.Ссылка, Шаблон.Ссылка,
        ПочтовыйПрофиль, Правило.VKRChannel, Правило.VKRNotificationType);
КонецФункции
