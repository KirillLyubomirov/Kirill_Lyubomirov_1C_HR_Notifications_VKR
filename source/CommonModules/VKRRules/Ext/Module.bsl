// Подбор адресатов и формирование письма для учебного стенда.
// Контракт метаданных: metadata_changes.json. Модуль серверный, неглобальный.

Функция НормализоватьEmail(Знач Адрес) Экспорт
    Адрес = СокрЛП(Строка(Адрес));
    Если ПустаяСтрока(Адрес) Или СтрДлина(Адрес) > 254 Тогда
        ВызватьИсключение "Email пустой или превышает 254 символа.";
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Адрес) Цикл
        Код = КодСимвола(Адрес, Позиция);
        Если Код <= 32 Или Код >= 127 Тогда
            ВызватьИсключение "Для учебного почтового профиля требуется адрес ASCII без пробелов.";
        КонецЕсли;
    КонецЦикла;
    Части = СтрРазделить(Адрес, "@", Истина);
    Если Части.Количество() <> 2 Тогда
        ВызватьИсключение "Email должен содержать один символ @.";
    КонецЕсли;
    ЛокальнаяЧасть = Части[0];
    Домен = Части[1];
    Если ПустаяСтрока(ЛокальнаяЧасть) Или СтрДлина(ЛокальнаяЧасть) > 64
        Или ПустаяСтрока(Домен) Тогда
        ВызватьИсключение "Неверная длина частей email.";
    КонецЕсли;
    Если Лев(ЛокальнаяЧасть, 1) = "." Или Прав(ЛокальнаяЧасть, 1) = "."
        Или СтрНайти(ЛокальнаяЧасть, "..") > 0 Тогда
        ВызватьИсключение "Неверное расположение точки в email.";
    КонецЕсли;
    Разрешено = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.!#$%&'*+-/=?^_`{|}~";
    Для Позиция = 1 По СтрДлина(ЛокальнаяЧасть) Цикл
        Если СтрНайти(Разрешено, Сред(ЛокальнаяЧасть, Позиция, 1)) = 0 Тогда
            ВызватьИсключение "Неподдерживаемый символ в email.";
        КонецЕсли;
    КонецЦикла;
    МеткиДомена = СтрРазделить(Домен, ".", Истина);
    Если МеткиДомена.Количество() < 2 Тогда
        ВызватьИсключение "Укажите доменное имя email.";
    КонецЕсли;
    Для Каждого Метка Из МеткиДомена Цикл
        Если ПустаяСтрока(Метка) Или СтрДлина(Метка) > 63
            Или Лев(Метка, 1) = "-" Или Прав(Метка, 1) = "-" Тогда
            ВызватьИсключение "Неверная часть доменного имени.";
        КонецЕсли;
        Для Позиция = 1 По СтрДлина(Метка) Цикл
            Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789-", НРег(Сред(Метка, Позиция, 1))) = 0 Тогда
                ВызватьИсключение "Неверный символ доменного имени.";
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    // Регистр локальной части сохраняется. Домен регистронезависим.
    Возврат ЛокальнаяЧасть + "@" + НРег(Домен);
КонецФункции

Функция НайтиПравило(ВидИзменения) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 2 П.Ссылка КАК Правило
        |ИЗ Справочник.PravilaRassylki КАК П
        |ГДЕ П.Aktivno И НЕ П.ПометкаУдаления
        |И П.VidIzmeneniya = &Вид";
    Запрос.УстановитьПараметр("Вид", ВидИзменения);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 0 Тогда
        ВызватьИсключение "Для вида изменения нет активного правила рассылки.";
    КонецЕсли;
    Если Таблица.Количество() > 1 Тогда
        ВызватьИсключение "Для вида изменения разрешено только одно активное правило.";
    КонецЕсли;
    Правило = Таблица[0].Правило.ПолучитьОбъект();
    Если НЕ ЗначениеЗаполнено(Правило.GruppaPoluchateley)
        Или НЕ ЗначениеЗаполнено(Правило.ShablonPisma) Тогда
        ВызватьИсключение "В правиле не указаны группа или шаблон.";
    КонецЕсли;
    Возврат Правило;
КонецФункции

Функция ПолучитьАдресатов(Документ, Правило) Экспорт
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Получатель");
    Результат.Колонки.Добавить("Email");
    Ссылки = Новый Соответствие;
    Адреса = Новый Соответствие;
    Если Документ.VKRManualRecipients Тогда
        Строки = Документ.Poluchateli;
    Иначе
        Группа = Правило.GruppaPoluchateley.ПолучитьОбъект();
        Если Группа.ПометкаУдаления Тогда
            ВызватьИсключение "Группа получателей помечена на удаление.";
        КонецЕсли;
        Строки = Группа.SostavGruppy;
    КонецЕсли;
    Для Каждого СтрокаСостава Из Строки Цикл
        Получатель = СтрокаСостава.Poluchatel;
        Если НЕ ЗначениеЗаполнено(Получатель) Тогда
            Продолжить;
        КонецЕсли;
        Карточка = Получатель.ПолучитьОбъект();
        Если Карточка.ПометкаУдаления Или НЕ Карточка.Aktiven Тогда
            Продолжить;
