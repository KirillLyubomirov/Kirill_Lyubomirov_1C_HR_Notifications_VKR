// Одно решение имеет постоянный идентификатор; перепроведение не меняет историю.
Процедура Решить(Знач Уведомление, Знач Решение, Знач Обоснование, Знач КлючРешения = "") Экспорт
    Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.VKROperatorDecisions) Тогда
        ВызватьИсключение "Недостаточно прав на решение по отправке.";
    КонецЕсли;
    Обоснование = СокрЛП(Обоснование);
    Если СтрДлина(Обоснование) < 10 Или СтрДлина(Обоснование) > 1000 Тогда
        ВызватьИсключение "Укажите результат проверки приёмника и основание решения: 10-1000 символов.";
    КонецЕсли;
    Если Решение <> "Retry" И Решение <> "Cancel" Тогда
        ВызватьИсключение "Неизвестная команда оператора.";
    КонецЕсли;
    ЦелевоеСостояние = ?(Решение = "Retry", Перечисления.VKRQueueStates.Retry, Перечисления.VKRQueueStates.Cancelled);
    Если ПустаяСтрока(КлючРешения) Тогда
        КлючРешения = Строка(Новый УникальныйИдентификатор);
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        VKROutbox.Заблокировать("VKRQueue", "Notification", Уведомление);
        ЗаписьРешения = РегистрыСведений.VKROperatorDecisions.СоздатьМенеджерЗаписи();
        ЗаписьРешения.DecisionID = КлючРешения;
        ЗаписьРешения.Прочитать();
        Если ЗаписьРешения.Выбран() Тогда
            Если ЗаписьРешения.Notification <> Уведомление
                Или ЗаписьРешения.NewState <> ЦелевоеСостояние
                Или ЗаписьРешения.Reason <> Обоснование Тогда
                ВызватьИсключение "Ключ решения уже использован для другого действия.";
            КонецЕсли;
        Иначе
            О = РегистрыСведений.VKRQueue.СоздатьМенеджерЗаписи();
            О.Notification = Уведомление;
            О.Прочитать();
            Если НЕ О.Выбран() Или (О.State <> Перечисления.VKRQueueStates.Unknown
                И О.State <> Перечисления.VKRQueueStates.Failed) Тогда
                ВызватьИсключение "Решение допускается для неизвестного результата или окончательной ошибки.";
            КонецЕсли;
            ИсходноеСостояние = О.State;
            Если Решение = "Retry" Тогда
                Если О.Attempts >= VKROutbox.ПределПопыток() Тогда
                    ВызватьИсключение "Лимит попыток исчерпан. История не обнуляется.";
                КонецЕсли;
                Если О.Event.ПометкаУдаления Или НЕ О.Event.Проведен Тогда
                    ВызватьИсключение "Событие отменено: повтор запрещён.";
                КонецЕсли;
                О.NextTry = ТекущаяДатаСеанса();
            КонецЕсли;
            О.State = ЦелевоеСостояние;
            О.Записать();
            ЗаписьРешения.DecisionID = КлючРешения;
            ЗаписьРешения.Notification = Уведомление;
            ЗаписьРешения.DecidedAt = ТекущаяДатаСеанса();
            ЗаписьРешения.OperatorName = ИмяПользователя();
            ЗаписьРешения.PreviousState = ИсходноеСостояние;
            ЗаписьРешения.NewState = О.State;
            ЗаписьРешения.Reason = Обоснование;
            ЗаписьРешения.Записать();
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
