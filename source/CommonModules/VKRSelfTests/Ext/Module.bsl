// Эти проверки исполняются только внутри установленной 1С после применения метаданных.
// Подготовка файла не означает, что проверки уже выполнены.

Функция ВыполнитьПроверки() Экспорт
    Результаты = Новый ТаблицаЗначений;
    Результаты.Колонки.Добавить("Тест");
    Результаты.Колонки.Добавить("Успех");
    Результаты.Колонки.Добавить("Подробности");
    ПроверитьАдрес(Результаты, "Пробелы и регистр домена", "  User@EXAMPLE.TEST  ", "User@example.test");
    ПроверитьАдрес(Результаты, "Плюс в локальной части", "user+hr@example.test", "user+hr@example.test");
    ПроверитьОтказАдреса(Результаты, "Два @", "a@@example.test");
    ПроверитьОтказАдреса(Результаты, "Перевод строки", "a@example.test" + Символы.ПС + "Bcc:x@example.test");
    ПроверитьОтказАдреса(Результаты, "Пустая локальная часть", "@example.test");
    ПроверитьОтказАдреса(Результаты, "Две точки в локальной части", "a..b@example.test");
    ПроверитьОтказАдреса(Результаты, "Пустая часть домена", "a@example..test");
    Параметры = Новый Структура("EmployeeName", "Тестовый сотрудник");
    Попытка
        Получено = VKRRules.ПрименитьШаблон("Изменение: {{EmployeeName}}", Параметры);
        Добавить(Результаты, "Подстановка шаблона", Получено = "Изменение: Тестовый сотрудник", Получено);
    Исключение
        Добавить(Результаты, "Подстановка шаблона", Ложь, ОписаниеОшибки());
    КонецПопытки;
    Попытка
        VKRRules.ПрименитьШаблон("{{UnknownParameter}}", Параметры);
        Добавить(Результаты, "Неизвестный параметр", Ложь, "Ожидаемое исключение отсутствует");
    Исключение
        Добавить(Результаты, "Неизвестный параметр", Истина, ОписаниеОшибки());
    КонецПопытки;
    Параметры.EmployeeName = "{{UnknownParameter}}";
    Попытка
        Получено = VKRRules.ПрименитьШаблон("{{EmployeeName}}", Параметры);
