// Реальный SMTP-транспорт для локального учебного стенда Mailpit.
// Успех означает подтверждённый приём SMTP-сервером, а не прочтение письма.

Функция ПараметрыСоединения(Уведомление = Неопределено) Экспорт
    Ссылка = Константы.VKRSMTPProfile.Получить();
    Если Уведомление <> Неопределено Тогда
        Если ЗначениеЗаполнено(Уведомление.VKRSMTPProfile) Тогда
            Ссылка = Уведомление.VKRSMTPProfile;
        КонецЕсли;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
        ВызватьИсключение "Не выбран почтовый профиль VKRSMTPProfile.";
    КонецЕсли;
    Профиль = Ссылка.ПолучитьОбъект();
    Если Профиль.ПометкаУдаления Тогда
        ВызватьИсключение "Почтовый профиль помечен на удаление.";
    КонецЕсли;
    Сервер = СокрЛП(Профиль.Server);
    Если Сервер <> "127.0.0.1" И Сервер <> "localhost" Тогда
        ВызватьИсключение "Эта сборка использует локальный SMTP-приёмник на 127.0.0.1.";
    КонецЕсли;
    Если Профиль.Port < 1 Или Профиль.Port > 65535 Тогда
        ВызватьИсключение "Порт SMTP должен быть от 1 до 65535.";
    КонецЕсли;
    Если НЕ ПустаяСтрока(Профиль.Login) Тогда
        ВызватьИсключение "Для локального профиля Mailpit оставьте логин пустым.";
    КонецЕсли;
    Отправитель = VKRRules.НормализоватьEmail(Профиль.EmailOtpravitelya);
    Возврат Новый Структура("Сервер,Порт,Отправитель", Сервер, Профиль.Port, Отправитель);
КонецФункции

Функция Отправить(Задание) Экспорт
    Р = Новый Структура("Состояние,Ошибка", Перечисления.VKRQueueStates.Failed, "");
    Попытка
        П = ПараметрыСоединения(Задание);
        Адрес = VKRRules.НормализоватьEmail(Задание.Email);
        Если ПустаяСтрока(Задание.TemaPisma) Или ПустаяСтрока(Задание.TekstPisma) Тогда
            ВызватьИсключение "В задании отсутствуют тема или текст.";
        КонецЕсли;
        Если СтрНайти(Задание.TemaPisma, Символы.ПС) > 0
            Или СтрНайти(Задание.TemaPisma, Символы.ВК) > 0 Тогда
