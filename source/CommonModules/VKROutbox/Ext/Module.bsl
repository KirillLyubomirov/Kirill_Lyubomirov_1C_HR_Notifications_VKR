// Очередь и история попыток. Все имена новых метаданных перечислены в manifest.
// Подготовка вызывается в транзакции проведения. Сеть вызывается вне транзакции.

Процедура Заблокировать(ИмяРегистра, Поле, Значение) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений." + ИмяРегистра);
    Элемент.УстановитьЗначение(Поле, Значение);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СнимокСобытия(Документ) Экспорт
    Д = Новый Структура;
    Д.Вставить("Employee", Документ.Sotrudnik);
    Д.Вставить("Kind", Документ.VidIzmeneniya);
    Д.Вставить("Reason", Документ.VKRReason);
    Д.Вставить("SourceKind", Документ.VKRSourceKind);
    Д.Вставить("Date", Документ.DataIzmeneniya);
    Д.Вставить("DepartmentBefore", Документ.PodrazdelenieDo);
    Д.Вставить("DepartmentAfter", Документ.PodrazdeleniePosle);
    Д.Вставить("PositionBefore", Документ.DolzhnostDo);
    Д.Вставить("PositionAfter", Документ.DolzhnostPosle);
    Д.Вставить("SalaryBefore", Документ.OkladDo);
    Д.Вставить("SalaryAfter", Документ.OkladPosle);
    Д.Вставить("Notify", Документ.TrebuyetsyaUvedomleniye);
    Д.Вставить("Manual", Документ.VKRManualRecipients);
    Если Документ.VKRManualRecipients Тогда
        Адресаты = Новый ТаблицаЗначений;
        Адресаты.Колонки.Добавить("Ref");
        Адресаты.Колонки.Добавить("Email");
        Для Каждого Строка Из Документ.Poluchateli Цикл
            Новая = Адресаты.Добавить();
            Новая.Ref = Строка.Poluchatel;
            Новая.Email = СокрЛП(Строка.Email);
        КонецЦикла;
        Адресаты.Сортировать("Email");
        Д.Вставить("Recipients", Адресаты);
    КонецЕсли;
    // Полное внутреннее представление исключает неоднозначную склейку полей.
    Возврат ЗначениеВСтрокуВнутр(Д);
КонецФункции

Процедура Подготовить(Документ) Экспорт
    Если НЕ ТранзакцияАктивна() Тогда
        ВызватьИсключение "Подготовка очереди должна выполняться в транзакции записи события.";
    КонецЕсли;
    Заблокировать("VKRSourceStates", "Event", Документ.Ссылка);
    Состояние = РегистрыСведений.VKRSourceStates.СоздатьМенеджерЗаписи();
    Состояние.Event = Документ.Ссылка;
    Состояние.Прочитать();
    Снимок = СнимокСобытия(Документ);
    Если Состояние.Выбран() И Состояние.Payload = Снимок И НЕ Состояние.Cancelled Тогда
        // Повтор без изменения события не создаёт новую ревизию и новые письма.
        Возврат;
    КонецЕсли;
    Ревизия = ?(Состояние.Выбран(), Состояние.Revision + 1, 1);
    Письма = Неопределено;
    Если Документ.TrebuyetsyaUvedomleniye Тогда
        Письма = VKRRules.ПодготовитьПисьма(Документ);
    КонецЕсли;
    ОтменитьОжидающие(Документ.Ссылка);
    Если Письма <> Неопределено Тогда
        Для Каждого Адресат Из Письма.Адресаты Цикл
            СоздатьЗадание(Документ, Ревизия, Снимок, Письма, Адресат);
        КонецЦикла;
    КонецЕсли;
    Состояние.Event = Документ.Ссылка;
    Состояние.Payload = Снимок;
    Состояние.Revision = Ревизия;
    Состояние.Cancelled = Ложь;
    Состояние.Записать();
КонецПроцедуры

Процедура СоздатьЗадание(Документ, Ревизия, Снимок, Письма, Адресат)
    Связь = РегистрыСведений.VKRNotificationKeys.СоздатьМенеджерЗаписи();
    Связь.Event = Документ.Ссылка;
    Связь.Revision = Ревизия;
    Связь.Email = Адресат.Email;
    Связь.Прочитать();
    Если Связь.Выбран() Тогда
        Возврат;
    КонецЕсли;
    Уведомление = Документы.OtpravkaUvedomleniya.СоздатьДокумент();
    Уведомление.Дата = ТекущаяДатаСеанса();
    Уведомление.Status = Перечисления.StatusyUvedomleniy.Podgotovleno;
    Уведомление.KadrovoyeIzmenenie = Документ.Ссылка;
    Уведомление.Sotrudnik = Документ.Sotrudnik;
    Уведомление.Poluchatel = Адресат.Получатель;
    Уведомление.Email = Адресат.Email;
    Уведомление.TemaPisma = Письма.Тема;
    Уведомление.TekstPisma = Письма.Текст;
    Уведомление.VKRRule = Письма.Правило;
    Уведомление.VKRSMTPProfile = Письма.Профиль;
    Уведомление.VKRChannel = Письма.Канал;
    Уведомление.VKRNotificationType = Письма.Назначение;
    Уведомление.VKRTemplate = Письма.Шаблон;
    Уведомление.VKRRevision = Ревизия;
    Уведомление.VKRSourceSnapshot = Снимок;
    Уведомление.VKRChangeType = Документ.VidIzmeneniya;
    Уведомление.VKRDepartment = ?(ЗначениеЗаполнено(Документ.PodrazdeleniePosle),
        Документ.PodrazdeleniePosle, Документ.PodrazdelenieDo);
    Уведомление.ДополнительныеСвойства.Вставить("VKRServiceWrite", Истина);
    Уведомление.Записать();
    Связь.Event = Документ.Ссылка;
    Связь.Revision = Ревизия;
    Связь.Email = Адресат.Email;
    Связь.Notification = Уведомление.Ссылка;
    Связь.Записать();
    Очередь = РегистрыСведений.VKRQueue.СоздатьМенеджерЗаписи();
    Очередь.Notification = Уведомление.Ссылка;
    Очередь.Event = Документ.Ссылка;
    Очередь.State = Перечисления.VKRQueueStates.Prepared;
    Очередь.Attempts = 0;
    Очередь.NextTry = ТекущаяДатаСеанса();
    Очередь.Записать();
КонецПроцедуры

Процедура ОтменитьОжидающие(Событие) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ О.Notification КАК Уведомление
        |ИЗ РегистрСведений.VKRQueue КАК О ГДЕ О.Event = &Событие";
    Запрос.УстановитьПараметр("Событие", Событие);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Заблокировать("VKRQueue", "Notification", Выборка.Уведомление);
        О = ПрочитатьОчередь(Выборка.Уведомление);
        Если О.State = Перечисления.VKRQueueStates.Sending
            Или О.State = Перечисления.VKRQueueStates.Unknown Тогда
            ВызватьИсключение "Сначала завершите или разберите незавершённую отправку этого события.";
        КонецЕсли;
        Если О.State <> Перечисления.VKRQueueStates.Sent Тогда
            О.State = Перечисления.VKRQueueStates.Cancelled;
            О.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ОтменитьСобытие(Событие) Экспорт
    Если НЕ ТранзакцияАктивна() Тогда
        ВызватьИсключение "Отмена события должна выполняться в транзакции.";
    КонецЕсли;
    Заблокировать("VKRSourceStates", "Event", Событие);
    ОтменитьОжидающие(Событие);
    Запись = РегистрыСведений.VKRSourceStates.СоздатьМенеджерЗаписи();
    Запись.Event = Событие;
    Запись.Прочитать();
    Если Запись.Выбран() Тогда
        Запись.Cancelled = Истина;
        Запись.Записать();
    КонецЕсли;
КонецПроцедуры

Функция ПрочитатьОчередь(Уведомление)
    О = РегистрыСведений.VKRQueue.СоздатьМенеджерЗаписи();
    О.Notification = Уведомление;
    О.Прочитать();
    Если НЕ О.Выбран() Тогда
        ВызватьИсключение "Задание отсутствует в очереди.";
    КонецЕсли;
    Возврат О;
КонецФункции

Функция ПределПопыток() Экспорт
    Возврат Макс(1, Мин(3, Константы.VKRMaxAttempts.Получить()));
КонецФункции

Процедура ОбработатьОчередь() Экспорт
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Отправку нельзя запускать внутри транзакции.";
    КонецЕсли;
    ВосстановитьНезавершенные();
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5 О.Notification КАК Уведомление
        |ИЗ РегистрСведений.VKRQueue КАК О
        |ГДЕ О.State В (&Подготовлено, &Повтор)
        |И О.NextTry <= &Сейчас И О.Attempts < &Предел
        |УПОРЯДОЧИТЬ ПО О.NextTry, О.Notification";
    Запрос.УстановитьПараметр("Подготовлено", Перечисления.VKRQueueStates.Prepared);
    Запрос.УстановитьПараметр("Повтор", Перечисления.VKRQueueStates.Retry);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
    Запрос.УстановитьПараметр("Предел", ПределПопыток());
    Задания = Запрос.Выполнить().Выгрузить();
    Для Каждого Строка Из Задания Цикл
        Попытка
            Токен = Захватить(Строка.Уведомление);
            Если ПустаяСтрока(Токен) Тогда
                Продолжить;
            КонецЕсли;
            Уведомление = Строка.Уведомление.ПолучитьОбъект();
            Результат = VKRMail.Отправить(Уведомление);
            Завершить(Строка.Уведомление, Токен, Результат);
        Исключение
            // Незавершённая попытка будет обнаружена по сроку захвата.
            ЗаписьЖурналаРегистрации("VKR.Очередь", УровеньЖурналаРегистрации.Ошибка,
                , Строка.Уведомление, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция Захватить(Уведомление)
    Токен = "";
    НачатьТранзакцию();
    Попытка
        Заблокировать("VKRQueue", "Notification", Уведомление);
        О = ПрочитатьОчередь(Уведомление);
        Готово = (О.State = Перечисления.VKRQueueStates.Prepared
            Или О.State = Перечисления.VKRQueueStates.Retry)
            И О.NextTry <= ТекущаяДатаСеанса() И О.Attempts < ПределПопыток();
        Если Готово Тогда
            Если О.Event.ПометкаУдаления Или НЕ О.Event.Проведен Тогда
                О.State = Перечисления.VKRQueueStates.Cancelled;
                О.Записать();
            Иначе
                Токен = Строка(Новый УникальныйИдентификатор);
                О.State = Перечисления.VKRQueueStates.Sending;
                О.ClaimToken = Токен;
                О.ClaimUntil = ТекущаяДатаСеанса() + 300;
                О.Attempts = О.Attempts + 1;
                О.Записать();
                П = РегистрыСведений.VKRAttempts.СоздатьМенеджерЗаписи();
                П.AttemptID = Токен;
                П.Notification = Уведомление;
                П.Started = ТекущаяДатаСеанса();
                П.Outcome = Перечисления.VKRQueueStates.Sending;
                П.Записать();
            КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Возврат Токен;
КонецФункции

Процедура Завершить(Уведомление, Токен, Результат)
    НачатьТранзакцию();
    Попытка
        Заблокировать("VKRQueue", "Notification", Уведомление);
        О = ПрочитатьОчередь(Уведомление);
        Если О.State <> Перечисления.VKRQueueStates.Sending Или О.ClaimToken <> Токен Тогда
            ВызватьИсключение "Попытка больше не владеет заданием.";
        КонецЕсли;
        О.State = Результат.Состояние;
        О.LastError = Лев(Результат.Ошибка, 1000);
        Если О.State = Перечисления.VKRQueueStates.Retry Тогда
            Если О.Attempts >= ПределПопыток() Тогда
                О.State = Перечисления.VKRQueueStates.Failed;
            Иначе
                Интервал = Макс(10, Константы.VKRRetrySeconds.Получить());
                О.NextTry = ТекущаяДатаСеанса() + Интервал * О.Attempts;
            КонецЕсли;
        КонецЕсли;
        О.ClaimToken = "";
        О.ClaimUntil = Дата(1, 1, 1);
        О.Записать();
        П = РегистрыСведений.VKRAttempts.СоздатьМенеджерЗаписи();
        П.AttemptID = Токен;
        П.Прочитать();
        Если НЕ П.Выбран() Тогда
            ВызватьИсключение "Не найдена начатая попытка отправки.";
        КонецЕсли;
        П.Finished = ТекущаяДатаСеанса();
        П.Outcome = О.State;
        П.ErrorText = О.LastError;
        П.Записать();
        ЗаписатьФакт(Уведомление, Токен, О.State, О.LastError);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьФакт(Ссылка, Токен, Состояние, Ошибка)
    У = Ссылка.ПолучитьОбъект();
    Если Состояние = Перечисления.VKRQueueStates.Sent Тогда
        У.Status = Перечисления.StatusyUvedomleniy.Otpravleno;
        У.DataOtpravki = ТекущаяДатаСеанса();
        У.ДополнительныеСвойства.Вставить("VKRServiceWrite", Истина);
        У.Записать();
        Набор = РегистрыНакопления.OtpravlennyeUvedomleniya.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Ссылка);
        Д = Набор.Добавить();
        Д.Активность = Истина;
        Д.Период = У.DataOtpravki;
        Д.Sotrudnik = У.Sotrudnik;
        Д.VidIzmeneniya = У.VKRChangeType;
        Д.Poluchatel = У.Poluchatel;
        Д.Status = У.Status;
        Д.Email = У.Email;
        Д.TemaPisma = У.TemaPisma;
        Д.DokumentOsnovanie = У.KadrovoyeIzmenenie;
        Д.Podrazdelenie = У.VKRDepartment;
        Д.Kolichestvo = 1;
        Набор.Записать();
    Иначе
        У.Status = Перечисления.StatusyUvedomleniy.Oshibka;
        У.ДополнительныеСвойства.Вставить("VKRServiceWrite", Истина);
        У.Записать();
        ДокОшибка = Документы.RegistratsiyaOshibkiOtpravki.СоздатьДокумент();
        ДокОшибка.Дата = ТекущаяДатаСеанса();
        ДокОшибка.KadrovoyeIzmenenie = У.KadrovoyeIzmenenie;
        ДокОшибка.Poluchatel = У.Poluchatel;
        ДокОшибка.Email = У.Email;
        ДокОшибка.OpisanieOshibki = Лев(Ошибка, 1000);
        ДокОшибка.DataOshibki = ДокОшибка.Дата;
        ДокОшибка.ДополнительныеСвойства.Вставить("VKRServiceWrite", Истина);
        ДокОшибка.VKRNotification = Ссылка;
        ДокОшибка.VKRAttemptID = Токен;
        ДокОшибка.VKRDescription = Лев(Ошибка, 1000);
        ДокОшибка.Записать();
        Набор = РегистрыНакопления.OshibkiOtpravkiUvedomleniy.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(ДокОшибка.Ссылка);
        Д = Набор.Добавить();
        Д.Активность = Истина;
        Д.Период = ДокОшибка.Дата;
        Д.Poluchatel = У.Poluchatel;
        Д.VidIzmeneniya = У.VKRChangeType;
        Д.OpisanieOshibki = Лев(Ошибка, 1000);
        Д.DokumentOsnovanie = У.KadrovoyeIzmenenie;
        Д.Podrazdelenie = У.VKRDepartment;
        Д.Kolichestvo = 1;
        Набор.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьНезавершенные()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ О.Notification КАК Уведомление, О.ClaimToken КАК Токен
        |ИЗ РегистрСведений.VKRQueue КАК О
        |ГДЕ О.State = &Отправка И О.ClaimUntil < &Сейчас";
    Запрос.УстановитьПараметр("Отправка", Перечисления.VKRQueueStates.Sending);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Р = Новый Структура("Состояние,Ошибка", Перечисления.VKRQueueStates.Unknown,
            "Истёк срок захвата. Проверить наличие письма в приёмнике до повторной отправки.");
        Попытка
            Завершить(Выборка.Уведомление, Выборка.Токен, Р);
        Исключение
            ЗаписьЖурналаРегистрации("VKR.Восстановление", УровеньЖурналаРегистрации.Ошибка,
                , Выборка.Уведомление, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры
