// Воспроизводимый учебный набор. Даты кадровых документов относятся к августу 2026 года.
// Технические даты подготовки, попыток и приёма SMTP записываются по фактическим часам платформы.

Функция НомерТекст(Номер)
    Возврат Прав("0" + СокрЛП(Строка(Номер)), 2);
КонецФункции

Функция Элемент(ИмяСправочника, Наименование, Поля)
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если НЕ Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Наименование;
    Для Каждого П Из Поля Цикл Объект[П.Ключ] = П.Значение; КонецЦикла;
    Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция Группа(ИмяСправочника, Наименование)
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если НЕ Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьГруппу(); Объект.Наименование = Наименование;
    Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция Пользователь(Имя, ПолноеИмя, Роль)
    П = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
    Если П = Неопределено Тогда
        П = ПользователиИнформационнойБазы.СоздатьПользователя();
        П.Имя = Имя; П.ПолноеИмя = ПолноеИмя;
        П.АутентификацияСтандартная = Истина; П.АутентификацияОС = Ложь;
        П.Роли.Добавить(Метаданные.Роли[Роль]); П.Записать();
    КонецЕсли;
    Возврат П;
КонецФункции

Процедура РазрешитьПодразделение(Пользователь, Подразделение)
    Доступ = РегистрыСведений.VKRDepartmentAccess.СоздатьМенеджерЗаписи();
    Доступ.UserID = Строка(Пользователь.УникальныйИдентификатор);
    Доступ.Department = Подразделение; Доступ.Enabled = Истина; Доступ.Записать();
КонецПроцедуры

Процедура ПодготовитьПользователей()
    Пользователь("vkr_Administrator", "Администратор стенда", "Administrator");
    Пользователь("vkr_Kadrovik", "Кадровик", "Kadrovik");
    Пользователь("vkr_OperatorUvedomleniy", "Оператор уведомлений", "OperatorUvedomleniy");
    Пользователь("vkr_Auditor", "Аудитор", "Auditor");
    Отделы = НаименованияОтделов();
    Для Индекс = 0 По 9 Цикл
        Имя = ?(Индекс = 0, "vkr_RukovoditelPodrazdeleniya", ?(Индекс = 1, "vkr_Manager_B", "vkr_Manager_" + НомерТекст(Индекс + 1)));
        П = Пользователь(Имя, "Руководитель: " + Отделы[Индекс], "RukovoditelPodrazdeleniya");
        Отдел = Справочники.Podrazdeleniya.НайтиПоНаименованию(Отделы[Индекс], Истина);
        Если НЕ Отдел.Пустая() Тогда РазрешитьПодразделение(П, Отдел); КонецЕсли;
    КонецЦикла;
    Пользователь("vkr_Manager_None", "Руководитель без назначенного подразделения", "RukovoditelPodrazdeleniya");
КонецПроцедуры

Функция НаименованияОтделов()
    Возврат СтрРазделить("Отдел кадров,Расчётная группа,Отдел разработки,Служба сопровождения,ИТ-служба,Отдел продаж,Отдел закупок,Финансовый отдел,Документооборот,Служба качества", ",");
КонецФункции

Функция Создать() Экспорт
    Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
        ВызватьИсключение "Учебные данные создаёт администратор.";
    КонецЕсли;
    Если Константы.VKRSendEnabled.Получить() Тогда
        ВызватьИсключение "Перед созданием учебных данных остановите отправку.";
    КонецЕсли;
    Если НЕ Справочники.Sotrudniki.НайтиПоНаименованию("Учебный сотрудник 01", Истина).Пустая() Тогда
        ПодготовитьПользователей();
        Возврат "Учебный набор уже существует. Документы и очередь сохранены без изменений.";
    КонецЕсли;
    ПроверкаБазы = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Sotrudniki");
    Если НЕ ПроверкаБазы.Выполнить().Пустой() Тогда
        ВызватьИсключение "Этот набор создаётся в отдельной пустой учебной базе.";
    КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Константы.VKRSendEnabled.Установить(Ложь);
        Константы.VKRMaxAttempts.Установить(3); Константы.VKRRetrySeconds.Установить(60);
        Отделы = Новый Массив; Должности = Новый Массив; Сотрудники = Новый Массив;
        Получатели = Новый Массив; Причины = Новый Массив; Основания = Новый Массив;
        Каналы = Новый Массив; Назначения = Новый Массив;
        ИменаОтделов = НаименованияОтделов();
        ИменаДолжностей = СтрРазделить("Специалист по кадрам,Бухгалтер,Разработчик,Специалист сопровождения,Системный администратор,Менеджер по продажам,Специалист по закупкам,Экономист,Делопроизводитель,Специалист по качеству", ",");
