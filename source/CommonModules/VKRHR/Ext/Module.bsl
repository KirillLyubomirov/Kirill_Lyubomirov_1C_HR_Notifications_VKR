// Специализированные документы используют единый кадровый факт и общую очередь.
Процедура ПроверитьСобытие(Событие) Экспорт
    Если НЕ ЗначениеЗаполнено(Событие.Sotrudnik)
        Или НЕ ЗначениеЗаполнено(Событие.VidIzmeneniya)
        Или НЕ ЗначениеЗаполнено(Событие.DataIzmeneniya) Тогда
        ВызватьИсключение "Заполните сотрудника, вид и дату изменения.";
    КонецЕсли;
    Если Событие.Sotrudnik.ПометкаУдаления Или Событие.VidIzmeneniya.ПометкаУдаления Тогда
        ВызватьИсключение "Сотрудник или вид изменения помечен на удаление.";
    КонецЕсли;
    Для Каждого ИмяПоля Из СтрРазделить("PodrazdelenieDo,PodrazdeleniePosle,DolzhnostDo,DolzhnostPosle", ",") Цикл
        Значение = Событие[ИмяПоля];
        Если ЗначениеЗаполнено(Значение) Тогда
            Если Значение.ПометкаУдаления Или Значение.ЭтоГруппа Тогда
                ВызватьИсключение "Укажите действующий элемент в поле " + ИмяПоля;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ВидПоТипу(ТипИзменения)
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Виды.Ссылка КАК Ссылка
        |ИЗ Справочник.VidyKadrovykhIzmeneniy КАК Виды
        |ГДЕ Виды.TipIzmeneniya = &Тип И НЕ Виды.ПометкаУдаления");
    Запрос.УстановитьПараметр("Тип", ТипИзменения);
    ОсновнойЗапрос = Новый Запрос(Запрос.Текст + " И Виды.VKRDefault");
    ОсновнойЗапрос.УстановитьПараметр("Тип", ТипИзменения);
    Таблица = ОсновнойЗапрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 0 Тогда
        // Совместимость с базами, созданными до появления признака основного вида.
        Таблица = Запрос.Выполнить().Выгрузить();
    КонецЕсли;
    Если Таблица.Количество() <> 1 Тогда
        ВызватьИсключение "Для типа изменения нужен ровно один действующий вид кадрового изменения.";
    КонецЕсли;
    Возврат Таблица[0].Ссылка;
КонецФункции

