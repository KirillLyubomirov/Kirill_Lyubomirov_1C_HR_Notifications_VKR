Процедура ПриНачалеРаботыСистемы()
    Если Лев(ПараметрЗапуска,8) = "VKRTEST|" Тогда
        ПодключитьОбработчикОжидания("VKRПриемка",1,Истина);
    КонецЕсли;
КонецПроцедуры

Процедура VKRПриемка() Экспорт
    П = СтрРазделить(ПараметрЗапуска,"|");
    Текст = VKRTestDriver.Прогнать(П[1]);
    Док = Новый ТекстовыйДокумент;
    Док.УстановитьТекст(Текст);
    Док.Записать(П[2],КодировкаТекста.UTF8);
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

