// Исполняется только в отдельной базе приёмки. Рабочие модули не заменяет.
// Нет привилегированного режима, подмены SMTP или прямой записи состояний очереди.

Функция Скаляр(Значение)
    Тип = ТипЗнч(Значение);
    Если Тип = Тип("Число") Или Тип = Тип("Булево") Или Тип = Тип("Строка") Тогда
        Возврат Значение;
    КонецЕсли;
    Если Тип = Тип("Дата") Тогда
        Возврат Формат(Значение, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
    КонецЕсли;
    Попытка
        Возврат Строка(Значение.УникальныйИдентификатор());
    Исключение
        Возврат Строка(Значение);
    КонецПопытки;
КонецФункции

Функция Строки(Текст, Параметры = Неопределено)
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл
            Запрос.УстановитьПараметр(П.Ключ, П.Значение);
        КонецЦикла;
    КонецЕсли;
    Таблица = Запрос.Выполнить().Выгрузить();
    Массив = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Д = Новый Структура;
        Для Каждого Колонка Из Таблица.Колонки Цикл
            Д.Вставить(Колонка.Имя, Скаляр(Строка[Колонка.Имя]));
        КонецЦикла;
        Массив.Добавить(Д);
    КонецЦикла;
    Возврат Массив;
КонецФункции

Функция Количество(Таблица)
    З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ " + Таблица);
    В = З.Выполнить().Выбрать(); В.Следующий();
    Возврат В.Число;
КонецФункции

Функция Первый(Имя)
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ." + Имя + " КАК Д УПОРЯДОЧИТЬ ПО Д.Ссылка");
    В = З.Выполнить().Выбрать();
    Если НЕ В.Следующий() Тогда ВызватьИсключение "Нет документа: " + Имя; КонецЕсли;
    Возврат В.Ссылка;
КонецФункции

Функция Очередь()
    Возврат Строки("ВЫБРАТЬ Notification, Event, State, Attempts, NextTry, ClaimUntil, LastError
        |ИЗ РегистрСведений.VKRQueue УПОРЯДОЧИТЬ ПО Notification");
КонецФункции

Функция Снимок()
    Д = Новый Структура;
    Д.Вставить("employees", Количество("Справочник.Sotrudniki"));
    Д.Вставить("events", Количество("Документ.KadrovoyeIzmenenie"));
    Д.Вставить("notifications", Количество("Документ.OtpravkaUvedomleniya"));
    Д.Вставить("sent", Количество("РегистрНакопления.OtpravlennyeUvedomleniya"));
    Д.Вставить("errors", Количество("РегистрНакопления.OshibkiOtpravkiUvedomleniy"));
    Д.Вставить("queue", Очередь());
    Д.Вставить("links", Строки("ВЫБРАТЬ Source, Event ИЗ РегистрСведений.VKRDocumentLinks УПОРЯДОЧИТЬ ПО Source"));
    Д.Вставить("revisions", Строки("ВЫБРАТЬ Event, Revision, Cancelled ИЗ РегистрСведений.VKRSourceStates УПОРЯДОЧИТЬ ПО Event"));
    Д.Вставить("attempts", Строки("ВЫБРАТЬ AttemptID, Notification, Started, Finished, Outcome, ErrorText ИЗ РегистрСведений.VKRAttempts УПОРЯДОЧИТЬ ПО Started, AttemptID"));
    Д.Вставить("decisions", Строки("ВЫБРАТЬ DecisionID, Notification, DecidedAt, OperatorName, PreviousState, NewState, Reason ИЗ РегистрСведений.VKROperatorDecisions УПОРЯДОЧИТЬ ПО DecidedAt, DecisionID"));
    Возврат Д;
КонецФункции

Процедура Проверить(Условие, Сообщение)
    Если НЕ Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Процедура СоздатьПользователей()
    Для Каждого Роль Из СтрРазделить("Administrator,Kadrovik,OperatorUvedomleniy,Auditor,RukovoditelPodrazdeleniya", ",") Цикл
        Имя = "vkr_" + Роль;
        Если ПользователиИнформационнойБазы.НайтиПоИмени(Имя) = Неопределено Тогда
            П = ПользователиИнформационнойБазы.СоздатьПользователя();
            П.Имя = Имя; П.ПолноеИмя = "ВКР: " + Роль;
            П.АутентификацияСтандартная = Истина;
            П.АутентификацияОС = Ложь;
            П.Роли.Добавить(Метаданные.Роли[Роль]);
            П.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция Задачи()
    Возврат Строки("ВЫБРАТЬ Ссылка, БизнесПроцесс, ТочкаМаршрута, Выполнена, Наименование ИЗ Задача.ZadachaPoKadrovomuIzmeneniyu УПОРЯДОЧИТЬ ПО Ссылка");
КонецФункции

Функция ПерваяЗадача()
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Задача.ZadachaPoKadrovomuIzmeneniyu ГДЕ НЕ Выполнена УПОРЯДОЧИТЬ ПО Ссылка");
    В = З.Выполнить().Выбрать();
    Если НЕ В.Следующий() Тогда ВызватьИсключение "Нет невыполненной задачи"; КонецЕсли;
    Возврат В.Ссылка;
КонецФункции

Функция НеизвестноеУведомление()
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Notification ИЗ РегистрСведений.VKRQueue ГДЕ State = ЗНАЧЕНИЕ(Перечисление.VKRQueueStates.Unknown) УПОРЯДОЧИТЬ ПО Notification");
    В = З.Выполнить().Выбрать();
    Если НЕ В.Следующий() Тогда ВызватьИсключение "Нет Unknown"; КонецЕсли;
    Возврат В.Notification;
КонецФункции

Функция ОтчетыЗаДень()
    М = Новый Массив;
    Для Каждого Имя Из СтрРазделить("KadrovyeIzmeneniyaZaPeriod,OtpravlennyeUvedomleniyaZaPeriod,OshibkiOtpravkiUvedomleniyZaPeriod,StatistikaPoVidamKadrovykhIzmeneniy,UvedomleniyaPoPodrazdeleniyam", ",") Цикл
        Схема = Отчеты[Имя].Создать().ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
        Период = Новый Структура("НачалоПериода,КонецПериода", Дата(2026,8,1), КонецДня(ТекущаяДатаСеанса()));
        Записи = Строки(Схема.НаборыДанных[0].Запрос, Период);
        Настройки = Схема.НастройкиПоУмолчанию;
        Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", Период.НачалоПериода);
        Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", Период.КонецПериода);
        Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
        Макет = Компоновщик.Выполнить(Схема, Настройки);
        Процессор = Новый ПроцессорКомпоновкиДанных;
        Процессор.Инициализировать(Макет);
        ТабДок = Новый ТабличныйДокумент;
        Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
        Вывод.УстановитьДокумент(ТабДок);
        Вывод.Вывести(Процессор);
        М.Добавить(Новый Структура("report,rows,height,data", Имя, Записи.Количество(), ТабДок.ВысотаТаблицы, Записи));
    КонецЦикла;
    Возврат М;
КонецФункции


Функция НастроитьПроверкуДоступа()
    Результат = Новый Массив;
    Имена = СтрРазделить("vkr_RukovoditelPodrazdeleniya,vkr_Manager_B,vkr_Manager_None", ",");
    Отделы = СтрРазделить("ВКР11: отдел разработки,ВКР11: отдел сопровождения", ",");
    Для Индекс = 0 По 2 Цикл
        Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Имена[Индекс]);
        Если Пользователь = Неопределено Тогда
            Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
            Пользователь.Имя = Имена[Индекс];
            Пользователь.ПолноеИмя = Имена[Индекс];
            Пользователь.АутентификацияСтандартная = Истина;
            Пользователь.АутентификацияОС = Ложь;
            Пользователь.Роли.Добавить(Метаданные.Роли.RukovoditelPodrazdeleniya);
            Пользователь.Записать();
        КонецЕсли;
        Если Индекс < 2 Тогда
            Отдел = Справочники.Podrazdeleniya.НайтиПоНаименованию(Отделы[Индекс], Истина);
            Проверить(НЕ Отдел.Пустая(), "Не найден отдел приёмки");
            Запись = РегистрыСведений.VKRDepartmentAccess.СоздатьМенеджерЗаписи();
            Запись.UserID = Строка(Пользователь.УникальныйИдентификатор);
            Запись.Department = Отдел;
            Запись.Enabled = Истина;
            Запись.Записать();
        КонецЕсли;
        Результат.Добавить(Новый Структура("user,id", Пользователь.Имя, Строка(Пользователь.УникальныйИдентификатор)));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СнимокДоступныхДанных()
    Результат = Новый Структура;
    Результат.Вставить("employees", Строки("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, Наименование, Podrazdelenie ИЗ Справочник.Sotrudniki"));
    Результат.Вставить("events", Строки("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, PodrazdelenieDo, PodrazdeleniePosle ИЗ Документ.KadrovoyeIzmenenie"));
    Результат.Вставить("notifications", Строки("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, VKRDepartment ИЗ Документ.OtpravkaUvedomleniya"));
    Результат.Вставить("queue", Строки("ВЫБРАТЬ РАЗРЕШЕННЫЕ Notification, State ИЗ РегистрСведений.VKRQueue"));
    Результат.Вставить("movements", Строки("ВЫБРАТЬ РАЗРЕШЕННЫЕ Регистратор, Podrazdelenie, Kolichestvo ИЗ РегистрНакопления.KadrovyeSobytiya"));
    Результат.Вставить("reports", ОтчетыЗаДень());
    Результат.Вставить("subject_write_denied", Ложь);
    Попытка
        ПараметрыСеанса.VKRCurrentUserID = "00000000-0000-0000-0000-000000000000";
    Исключение
        Результат.subject_write_denied = Истина;
        Результат.Вставить("subject_write_error", ОписаниеОшибки());
    КонецПопытки;
    Результат.Вставить("unfiltered_read_denied", Ложь);
    Попытка
        Строки("ВЫБРАТЬ Ссылка, Email ИЗ Документ.OtpravkaUvedomleniya");
    Исключение
        Результат.unfiltered_read_denied = Истина;
        Результат.Вставить("unfiltered_read_error", ОписаниеОшибки());
    КонецПопытки;
    Результат.Вставить("mapping_write_right",ПравоДоступа("Изменение",Метаданные.РегистрыСведений.VKRDepartmentAccess));
    Возврат Результат;
КонецФункции

Функция Прогнать(Сценарий) Экспорт
    Р = Новый Структура("scenario,version,user,at,ok", Сценарий, Метаданные.Версия, ИмяПользователя(), Формат(ТекущаяДатаСеанса(),"ДФ=yyyy-MM-dd'T'HH:mm:ss"), Истина);
    Попытка
        Если Сценарий = "rls_setup" Тогда
            Р.Вставить("users", НастроитьПроверкуДоступа());
            Р.Вставить("notifications", Строки("ВЫБРАТЬ Ссылка, VKRDepartment ИЗ Документ.OtpravkaUvedomleniya"));
        ИначеЕсли Сценарий = "rls_read" Тогда
            Р.Вставить("visible", СнимокДоступныхДанных());
        ИначеЕсли Лев(Сценарий, 14) = "rls_forbidden:" Тогда
            Ссылка = Документы.OtpravkaUvedomleniya.ПолучитьСсылку(Новый УникальныйИдентификатор(Сред(Сценарий, 15)));
            Р.Вставить("direct_read_denied", Ложь);
            Попытка
                Объект = Ссылка.ПолучитьОбъект();
                Р.Вставить("unexpected_email", Объект.Email);
            Исключение
                Р.direct_read_denied = Истина;
                Р.Вставить("direct_read_error", ОписаниеОшибки());
            КонецПопытки;
            Проверить(Р.direct_read_denied,"Чужое уведомление доступно по прямой ссылке");
        ИначеЕсли Сценарий = "setup" Тогда
            Р.Вставить("created", VKRDemo.Создать());
            Р.Вставить("repeat", VKRDemo.Создать());
            СоздатьПользователей();
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "snapshot" Тогда
            Р.Вставить("snapshot", Снимок());
            Р.Вставить("tasks", Задачи());
        ИначеЕсли Сценарий = "repost" Тогда
            До = Снимок();
            Для Каждого Имя Из СтрРазделить("PriemSotrudnika,PerevodSotrudnika,UvolnenieSotrudnika,IzmenenieDolzhnosti,IzmeneniePodrazdeleniya,IzmenenieOklada", ",") Цикл
                Первый(Имя).ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
            КонецЦикла;
            После = Снимок(); Р.Вставить("before", До); Р.Вставить("after", После);
            Проверить(ЗначениеВСтрокуВнутр(До) = ЗначениеВСтрокуВнутр(После), "Снимок изменился при перепроведении");
        ИначеЕсли Сценарий = "change" Тогда
            Р.Вставить("before", Снимок());
            Д = Первый("IzmenenieOklada").ПолучитьОбъект();
            Д.OkladPosle = Д.OkladPosle + 1000;
            Д.Записать(РежимЗаписиДокумента.Проведение);
            Р.Вставить("after", Снимок());
        ИначеЕсли Сценарий = "unpost" Тогда
            Р.Вставить("before", Снимок());
            Первый("PriemSotrudnika").ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения);
            Р.Вставить("after", Снимок());
        ИначеЕсли Сценарий = "enable" Тогда
            Константы.VKRRetrySeconds.Установить(10);
            Константы.VKRSendEnabled.Установить(Истина);
        ИначеЕсли Сценарий = "disable" Тогда
            Константы.VKRSendEnabled.Установить(Ложь);
        ИначеЕсли Сценарий = "cycle" Тогда
            VKRJobs.ВыполнитьЦикл();
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "reports" Тогда
            Р.Вставить("reports", ОтчетыЗаДень());
        ИначеЕсли Сценарий = "coverage" Тогда
            Состав = Новый Массив;
            Для Каждого МД Из Метаданные.Справочники Цикл
                Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ Справочник." + МД.Имя;
                Если МД.Иерархический Тогда Текст = Текст + " ГДЕ НЕ ЭтоГруппа"; КонецЕсли;
                В = Новый Запрос(Текст); В = В.Выполнить().Выбрать(); В.Следующий();
                Состав.Добавить(Новый Структура("kind,name,count", "Catalog", МД.Имя, В.Число));
            КонецЦикла;
            Для Каждого МД Из Метаданные.Документы Цикл
                Состав.Добавить(Новый Структура("kind,name,count", "Document", МД.Имя, Количество("Документ." + МД.Имя)));
            КонецЦикла;
            Состав.Добавить(Новый Структура("kind,name,count", "BusinessProcess", "ObrabotkaKadrovogoIzmeneniya", Количество("БизнесПроцесс.ObrabotkaKadrovogoIzmeneniya")));
            Состав.Добавить(Новый Структура("kind,name,count", "Task", "ZadachaPoKadrovomuIzmeneniyu", Количество("Задача.ZadachaPoKadrovomuIzmeneniyu")));
            Р.Вставить("coverage", Состав);
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "batch_send" Тогда
            Для Н = 1 По 30 Цикл VKRJobs.ВыполнитьЦикл(); КонецЦикла;
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "batch_retry" Тогда
            Для Н = 1 По 10 Цикл
                Д = Документы.PovtornayaOtpravkaUvedomleniya.СоздатьДокумент();
                Д.Дата = ТекущаяДатаСеанса(); Д.DataPovtora = Д.Дата;
                Д.IshodnoyeUvedomleniye = НеизвестноеУведомление();
                Д.Kommentariy = "Локальный испытательный приёмник закрыл соединение до подтверждения DATA. После сверки журнала разрешён контролируемый повтор в Mailpit.";
                Д.Записать(РежимЗаписиДокумента.Проведение);
                Д.Записать(РежимЗаписиДокумента.Проведение);
            КонецЦикла;
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "batch_workflow" Тогда
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка ИЗ Документ.KadrovoyeIzmenenie УПОРЯДОЧИТЬ ПО Дата, Ссылка");
            В = Запрос.Выполнить().Выбрать();
            Пока В.Следующий() Цикл
                БП = БизнесПроцессы.ObrabotkaKadrovogoIzmeneniya.СоздатьБизнесПроцесс();
                БП.Дата = ТекущаяДатаСеанса(); БП.KadrovoyeIzmenenie = В.Ссылка;
                БП.Записать(); БП.Старт();
                Для Шаг = 1 По 5 Цикл
                    ЗапросЗадачи = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Задача.ZadachaPoKadrovomuIzmeneniyu ГДЕ БизнесПроцесс = &Процесс И НЕ Выполнена");
                    ЗапросЗадачи.УстановитьПараметр("Процесс", БП.Ссылка);
                    ВЗ = ЗапросЗадачи.Выполнить().Выбрать();
                    Проверить(ВЗ.Следующий(), "Ожидается очередная задача маршрута");
                    ВЗ.Ссылка.ПолучитьОбъект().ВыполнитьЗадачу();
                КонецЦикла;
                Проверить(БП.Ссылка.Завершен, "Маршрут не завершён");
            КонецЦикла;
            Р.Вставить("tasks", Задачи());
        ИначеЕсли Сценарий = "workflow_start" Тогда
            БП = БизнесПроцессы.ObrabotkaKadrovogoIzmeneniya.СоздатьБизнесПроцесс();
            БП.Дата = ТекущаяДатаСеанса();
            БП.KadrovoyeIzmenenie = Первый("KadrovoyeIzmenenie");
            БП.Записать(); БП.Старт();
            Р.Вставить("process", Скаляр(БП.Ссылка)); Р.Вставить("tasks", Задачи());
        ИначеЕсли Сценарий = "workflow_step" Тогда
            З = ПерваяЗадача(); Р.Вставить("before", Задачи());
            Попытка
                З.ПолучитьОбъект().ВыполнитьЗадачу();
            Исключение
                Р.Вставить("denied", ОписаниеОшибки());
            КонецПопытки;
            Р.Вставить("executed", З.ПолучитьОбъект().Выполнена);
            Р.Вставить("after", Задачи());
            Р.Вставить("completed", З.БизнесПроцесс.Завершен);
        ИначеЕсли Сценарий = "guards" Тогда
            У = Первый("OtpravkaUvedomleniya");
            Р.Вставить("write_denied", Ложь); Р.Вставить("delete_denied", Ложь);
            Попытка
                Объект = У.ПолучитьОбъект(); Объект.Kommentariy = "Попытка ручного изменения в приёмке"; Объект.Записать();
            Исключение
                Р.write_denied = Истина; Р.Вставить("write_error", ОписаниеОшб(ИнформацияОбОшибке()));
            КонецПопытки;
            Попытка
                У.ПолучитьОбъект().Удалить();
            Исключение
                Р.delete_denied = Истина; Р.Вставить("delete_error", ОписаниеОшибки());
            КонецПопытки;
            Проверить(Р.write_denied И Р.delete_denied, "Защита служебного документа не сработала");
        ИначеЕсли Сценарий = "roles" Тогда
            Р.Вставить("send_setting_right", ПравоДоступа("Изменение", Метаданные.Константы.VKRSendEnabled));
            Р.Вставить("operator_right", ПравоДоступа("Изменение", Метаданные.РегистрыСведений.VKROperatorDecisions));
            Р.Вставить("setting_denied", Ложь);
            Попытка
                Константы.VKRSendEnabled.Установить(Истина);
            Исключение
                Р.setting_denied = Истина; Р.Вставить("setting_error", ОписаниеОшибки());
            КонецПопытки;
            VKRJobs.ВыполнитьЦикл();
        ИначеЕсли Сценарий = "resolve_failed" Тогда
            З = Новый Запрос("ВЫБРАТЬ Notification ИЗ РегистрСведений.VKRQueue ГДЕ State = ЗНАЧЕНИЕ(Перечисление.VKRQueueStates.Failed)");
            В = З.Выполнить().Выбрать();
            Пока В.Следующий() Цикл
                VKROperator.Решить(В.Notification,"Cancel","Приёмка отказа соединения завершена: три попытки исчерпаны, дальнейшая передача прекращена.");
            КонецЦикла;
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "decision_cancel" Тогда
            У = НеизвестноеУведомление();
            VKROperator.Решить(У,"Cancel","Приёмник проверен в ходе приёмки: неопределённый результат закрыт без повторной передачи.");
            Р.Вставить("snapshot", Снимок());
        ИначеЕсли Сценарий = "retry_document" Тогда
            Р.Вставить("before", Снимок());
            Д = Документы.PovtornayaOtpravkaUvedomleniya.СоздатьДокумент();
            Д.Дата = ТекущаяДатаСеанса(); Д.DataPovtora = Д.Дата;
            Д.IshodnoyeUvedomleniye = НеизвестноеУведомление();
            Д.Kommentariy = "Приёмник проверен: подтверждённого письма нет. Разрешён один повтор в пределах лимита.";
            Д.Записать(РежимЗаписиДокумента.Проведение);
            Д.Записать(РежимЗаписиДокумента.Проведение);
            Р.Вставить("document", Скаляр(Д.Ссылка)); Р.Вставить("after", Снимок());
        Иначе
            ВызватьИсключение "Неизвестный сценарий приёмки";
        КонецЕсли;
    Исключение
        Р.ok = Ложь; Р.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    З = Новый ЗаписьJSON; З.УстановитьСтроку(); ЗаписатьJSON(З,Р);
    Возврат З.Закрыть();
КонецФункции

Функция ОписаниеОшб(Информация)
    Возврат ПодробноеПредставлениеОшибки(Информация);
КонецФункции

